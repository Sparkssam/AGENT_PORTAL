# Supabase Auth + Storage (never commit real keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for registration and admin bootstrap. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Prisma → Supabase Postgres (Settings → Database).
# DATABASE_URL: pooled URI on port 6543 for app queries (?pgbouncer=true).
# DIRECT_URL: session URI on port 5432 for migrations and Prisma transactions.
# Interactive transactions (submit, verify document) fail on the pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Public site URL for password-reset redirects and operational email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin (optional). Then: node --env-file=.env.local scripts/ensure-admin.mjs
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional: Resend for correction / reject / completed emails to agents.
# Without this key, the portal still writes in-app notifications.
# RESEND_API_KEY=
# EMAIL_FROM="Kinetic <noreply@your-domain.com>"

# Live document files use Supabase Storage (bucket application-documents).
# Cloudflare R2 helpers in lib/r2 are unused unless you migrate later.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# Optional: WhatsApp support number (digits only, country code first).
# Used by Chat with Support on the agent Help Center and rejected documents.
# NEXT_PUBLIC_WHATSAPP_SUPPORT=255700000000
# ID_VERIFICATION_PROVIDER=none

# Apply SQL in order (Supabase SQL editor or node --env-file=.env.local scripts/apply-sql.mjs <file>):
#   supabase/migrations/20260817120000_init.sql
#   supabase/seed.sql
#   supabase/migrations/20260817140000_storage.sql
#   supabase/migrations/20260817150000_mutation_guards.sql
#   supabase/migrations/20260819120000_document_verifications.sql
#   supabase/migrations/20260819140000_business_sectors.sql
#   supabase/migrations/20260821120000_document_admin_upload.sql
#
# Dev-only: "Submit test application" runs when NODE_ENV=development. Do not use it
# for stakeholder demos — those cases have no real files to preview or download.
