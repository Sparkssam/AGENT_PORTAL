{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:pull": "node --env-file=.env.local ./node_modules/prisma/build/index.js db pull",
    "db:push": "node --env-file=.env.local ./node_modules/prisma/build/index.js db push",
    "db:studio": "node --env-file=.env.local ./node_modules/prisma/build/index.js studio",
    "db:seed": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:validate": "prisma validate",
    "admin:ensure": "node --env-file=.env.local scripts/ensure-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.16.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.8.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "pg": "^8.23.0",
    "postcss": "^8.5",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  },
  "prisma": {
    "seed": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  }
}
